runs/**/activations.pt
runs/**/activations_raw_blocks.pt
runs/**/activations_block*.pt

# Usual notebook / Python cruft.
.ipynb_checkpoints/
__pycache__/
*.py[cod]
.venv/
venv/
# Bulky derived artifacts: hashed in runs/**/bulky_artifacts_manifest.json, backed up with rclone.
runs/**/*.npz
runs/**/lens_readout/all50_psych_vocab_ranks.csv
